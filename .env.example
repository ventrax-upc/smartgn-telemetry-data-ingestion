# Local composition secrets. Copy to .env before starting.
INFLUX_PASSWORD=local-influx-password
INFLUX_TOKEN=local-influx-token-change-me
INTERNAL_SERVICE_TOKEN=local-internal-token-change-me
# Sibling services of the shared integrated composition (optional here).
INSTALLATION_BASE_URL=http://host.docker.internal:8081
ALERTING_EVENTS_SINK_URL=http://host.docker.internal:8086/internal/v1/telemetry-events
