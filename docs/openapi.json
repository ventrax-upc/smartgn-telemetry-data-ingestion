{
  "openapi": "3.1.1",
  "info": {
    "title": "SmartGN - Telemetry & Data Ingestion",
    "description": "MQTT ingestion, validation, deduplication and normalization of device telemetry. Exposes private device operations over authenticated HTTP and a private gRPC query contract.",
    "license": {
      "name": "MIT"
    },
    "version": "v1"
  },
  "paths": {
    "/internal/v1/device-associations": {
      "post": {
        "tags": [
          "Internal telemetry"
        ],
        "summary": "Records a versioned device association and acknowledges the exact\ndevice and version that was sent.",
        "description": "Confirms the device, account, property, supply point and association version provided by Installation. Requires the private service credential when configured.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAssociationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAssociationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAssociationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AssociationConfirmationView"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssociationConfirmationView"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssociationConfirmationView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/internal/v1/devices/status-query": {
      "post": {
        "tags": [
          "Internal telemetry"
        ],
        "summary": "Last contact of each requested device, restricted to the requested\nscope.",
        "description": "Returns last-contact state for the requested device identifiers within the account and purpose scope. Requires the private service credential when configured.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationalStatusRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationalStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OperationalStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationalStatusView"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationalStatusView"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationalStatusView"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/internal/v1/devices/{deviceId}/buffer-drain": {
      "post": {
        "tags": [
          "Internal telemetry"
        ],
        "summary": "Confirms that nothing of the given association is still outstanding.",
        "description": "Reports whether readings remain outstanding for the specified device association version. Requires the private service credential when configured.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BufferDrainRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BufferDrainRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BufferDrainRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BufferDrainView"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BufferDrainView"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BufferDrainView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AssociationConfirmationView": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "Acknowledgement of an association. Installation only accepts a confirmation\nthat names the exact device and version it sent."
      },
      "BufferDrainRequest": {
        "type": "object",
        "properties": {
          "associationVersion": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false,
        "description": "Drain request for the association a device is about to leave."
      },
      "BufferDrainView": {
        "type": "object",
        "properties": {
          "drained": {
            "type": "boolean"
          },
          "pendingReadings": {
            "type": "integer",
            "format": "int64"
          },
          "evidenceId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Drain outcome. A confirmed drain always reports zero pending readings and\na non-empty evidence identifier, because Installation refuses anything else."
      },
      "DeviceAssociationRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": [
              "null",
              "string"
            ]
          },
          "propertyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "pointId": {
            "type": [
              "null",
              "string"
            ]
          },
          "validFrom": {
            "type": "null"
          },
          "validTo": {
            "type": "null"
          }
        },
        "additionalProperties": false,
        "description": "Association synchronized by Installation. The timestamps are bound as raw\nJSON because a sibling serializer may write an instant as ISO-8601 text or\nas an epoch array; the controller normalizes them through the domain\nparser instead of failing on a shape this service does not control."
      },
      "OperationalStatusRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": [
              "null",
              "string"
            ]
          },
          "deviceIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Request for the operational status of a set of devices. The purpose must\nname the decision being taken, so this port cannot be reused for another."
      },
      "OperationalStatusView": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "connectionState": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastContact": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "Status of one requested device. `LastContact` is when the reading was\nreceived here; it is `null` when the device has never been heard from,\nnever an assumed observation (RNF17)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": {}
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Current IAM JWT for public user APIs.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceAuth": {
        "type": "http",
        "description": "Private service credential, independent of user JWTs. Internal routes must remain outside public gateway routing.",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Internal telemetry",
      "description": "Private service-to-service contracts for device lifecycle and operational status."
    }
  ]
}
